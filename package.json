{
  "name": "invoice-to-sheet",
  "version": "1.0.0",
  "description": "CLI that turns a folder of PDF invoices into a clean CSV/JSON using Claude, with a deterministic mock mode for offline demos.",
  "type": "module",
  "license": "MIT",
  "author": "Sergio Ortiz",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "invoice-to-sheet": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "demo": "tsx src/cli.ts samples --mock --out output",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "invoice",
    "pdf",
    "claude",
    "anthropic",
    "automation",
    "csv",
    "ocr",
    "data-extraction"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "commander": "^15.1.0",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.9",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
